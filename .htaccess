# ============================================================
#  benjamin-gonzalez-design.fr — configuration Apache
#  Sécurité, performance et redirections.
#  Si votre hébergeur utilise nginx, ce fichier est ignoré :
#  demandez-lui l'équivalent (voir README).
# ============================================================

# ── Page d'accueil ──
DirectoryIndex index.html index.php

# ── Forcer HTTPS et supprimer le www ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ── En-têtes de sécurité ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Politique de contenu : n'autorise que ce dont le site a besoin.
  # Si vous hébergez les polices et les images en local (recommandé),
  # vous pouvez retirer les adresses de Google et d'Unsplash.
  Header always set Content-Security-Policy "default-src 'self'; \
img-src 'self' data: https://images.unsplash.com; \
style-src 'self' https://fonts.googleapis.com; \
font-src 'self' https://fonts.gstatic.com; \
script-src 'self' 'unsafe-inline'; \
connect-src 'self'; \
form-action 'self'; \
frame-ancestors 'self'; \
base-uri 'self'"
  Header unset X-Powered-By
</IfModule>

# ── Masquer la version de PHP ──
<IfModule mod_php.c>
  php_flag expose_php off
  php_flag display_errors off
</IfModule>

# ── Interdire l'accès aux fichiers sensibles ──
<FilesMatch "(^\.|composer\.(json|lock)|\.(log|md|ini|sh|bak|sql)$)">
  Require all denied
</FilesMatch>

# ── Empêcher le listage des dossiers ──
Options -Indexes

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ── Mise en cache navigateur ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ── Type correct pour les polices et le manifeste ──
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest
